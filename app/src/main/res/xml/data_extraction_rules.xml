<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="NamuFarm.db" />
        <include domain="database" path="NamuFarm.db-wal" />
        <include domain="database" path="NamuFarm.db-shm" />
        <include domain="database" path="NamuFarmQuotes.db" />
        <include domain="database" path="NamuFarmQuotes.db-wal" />
        <include domain="database" path="NamuFarmQuotes.db-shm" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="operations_master_device.xml" />
        <exclude domain="sharedpref" path="operations_master_device.xml.bak" />
        <include domain="file" path="sync_backup/" />
        <!-- Android excludes cache/code_cache automatically; root is not included here. -->
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="NamuFarm.db" />
        <include domain="database" path="NamuFarm.db-wal" />
        <include domain="database" path="NamuFarm.db-shm" />
        <include domain="database" path="NamuFarmQuotes.db" />
        <include domain="database" path="NamuFarmQuotes.db-wal" />
        <include domain="database" path="NamuFarmQuotes.db-shm" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="operations_master_device.xml" />
        <exclude domain="sharedpref" path="operations_master_device.xml.bak" />
        <include domain="file" path="sync_backup/" />
        <!-- Android excludes cache/code_cache automatically; root is not included here. -->
    </device-transfer>
</data-extraction-rules>
